# ==========================================
# MechNova Global Environment Configuration
# ==========================================

# -----------------
# Backend (FastAPI)
# -----------------
# Optional Google Gemini AI API Key for live multimodal reasoning:
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Port and Host configurations
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production

# -----------------
# Frontend (React + Vite)
# -----------------
# Firebase Client Configuration (Optional - Demo mode automatically activates if blank)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=mechnova-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mechnova-ai
VITE_FIREBASE_STORAGE_BUCKET=mechnova-ai.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
